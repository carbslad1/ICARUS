{
  "name": "icarus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:sim": "vitest run --project sim",
    "test:web": "vitest run --project browser",
    "test:e2e": "playwright test",
    "bench": "vitest bench --project sim --run",
    "verify": "npm run typecheck && npm run lint && npm run test:sim && npm run test:web && npm run test:e2e",
    "postverify": "node scripts/check-verify-budget.mjs",
    "preverify": "node scripts/start-verify.mjs",
    "replay": "node scripts/replay.mjs",
    "record:empty": "node scripts/record-empty.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.20.2",
    "@vitest/browser": "3.2.7",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "playwright": "^1.58.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.57.0",
    "vite": "^6.4.0",
    "vitest": "3.2.7"
  }
}
